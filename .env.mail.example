# Copy to .env.mail and replace these three values with independent random secrets.
MAIL_PG_PASSWORD=replace-with-random-password
MAIL_SECRET=replace-with-random-encryption-key-at-least-32-characters
MAIL_ADMIN_TOKEN=replace-with-random-service-token-at-least-32-characters
MAIL_PORT=8095
MAIL_PUBLIC_URL=http://localhost:8095
# Optional trusted host gateway: POST {base}/match and {base}/import.
# Matching and selection confirmation remain disabled until this is configured.
MAIL_HOST_GATEWAY_URL=
MAIL_HOST_GATEWAY_SECRET=
# Minimum seconds between automatic continuous scans for one binding.
# Defaults to 180 (3 minutes); 0 disables the cooldown.
# The scheduler checks every 30 seconds, so values are aligned to 30 seconds.
MAIL_CONTINUOUS_INTERVAL_SECONDS=180
# Gmail connection mode: imap (app password, default) or oauth.
# oauth requires MAIL_GOOGLE_CLIENT_ID/SECRET and the Google callback configuration.
MAIL_GMAIL_AUTH_MODE=imap
# Optional HTTP/SOCKS proxy for IMAP connections (Gmail/QQ from restricted networks).
# Example: http://host.docker.internal:7890
MAIL_IMAP_PROXY=
MAIL_GOOGLE_CLIENT_ID=
MAIL_GOOGLE_CLIENT_SECRET=
MAIL_MICROSOFT_CLIENT_ID=
MAIL_MICROSOFT_CLIENT_SECRET=
MAIL_MICROSOFT_TENANT=common

# Fixed PinTalent page to return to after Google/Microsoft consent (local example).
MAIL_OAUTH_RETURN_URL=http://localhost:5173/mail

# Microsoft OAuth cloud: china (21Vianet) or global. Uses readonly mail access.
MAIL_MICROSOFT_CLOUD=china
